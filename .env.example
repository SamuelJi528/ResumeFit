GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional shared access code for a class demo. Visitors never enter your Gemini key.
SITE_ACCESS_CODE=
REQUESTS_PER_MINUTE=5
DAILY_GENERATION_LIMIT=100

# Use 0 locally and 1 on Vercel to trust its forwarded client IP and HTTPS scheme.
TRUST_PROXY=0
PORT=8000
