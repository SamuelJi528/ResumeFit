GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional shared access code for a class demo. Visitors never enter your Gemini key.
SITE_ACCESS_CODE=
REQUESTS_PER_MINUTE=5
DAILY_GENERATION_LIMIT=100

# Set to 1 only on a host with one trusted reverse proxy, such as the Render setup.
TRUST_PROXY=0
PORT=8000
