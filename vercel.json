{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "flask",
  "functions": {
    "server.py": {
      "maxDuration": 300,
      "includeFiles": "{templates/**,samples/**}",
      "excludeFiles": "{{public,tests,docs,__pycache__,.venv,venv,.git,.vercel,.aws,.ssh,.codex,.agents,.gemini,secrets,uploads,private,reports,instance}/**,**/.env*,**/secrets.*,**/*credentials*.json,**/*service?account*.json,**/client_secret*.json,**/*.{pem,key,p12,pfx}}"
    }
  },
  "headers": [
    {
      "source": "/static/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}
